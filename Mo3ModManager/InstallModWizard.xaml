<Window x:Class="Mo3ModManager.InstallModWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mo3ModManager"
        mc:Ignorable="d"
        FontSize="14"
        Title="Install Mod..." Height="480" Width="640" WindowStartupLocation="CenterOwner">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="IntroText" Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="This archive doesn't have a node.json for this mod manager. Select which folder's contents should become the mod's files, then fill in the details below." />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" x:Name="FolderGroupBox" Header="Select content folder:">
                <TreeView x:Name="FolderTreeView" SelectedItemChanged="FolderTreeView_SelectedItemChanged">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type local:FolderTreeNode}" ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}" />
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded" Value="True" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </GroupBox>

            <GroupBox Grid.Column="2" x:Name="DetailsGroupBox" Header="Mod details:">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4">
                        <TextBlock x:Name="NameLabel" Text="Name:" />
                        <TextBox x:Name="NameTextBox" Margin="0,2,0,8" />

                        <TextBlock x:Name="IdLabel" Text="ID:" />
                        <TextBox x:Name="IdTextBox" Margin="0,2,0,8" />

                        <TextBlock x:Name="MainExecutableLabel" Text="Main executable (optional, leave blank if this mod is data-only):" TextWrapping="Wrap" />
                        <ComboBox x:Name="MainExecutableComboBox" Margin="0,2,0,8" IsEditable="True" />

                        <TextBlock x:Name="ArgumentsLabel" Text="Arguments (optional):" />
                        <TextBox x:Name="ArgumentsTextBox" Margin="0,2,0,8" />

                        <TextBlock x:Name="ParentLabel" Text="Parent mod (optional, choose the base mod this depends on):" TextWrapping="Wrap" />
                        <ComboBox x:Name="ParentComboBox" Margin="0,2,0,8" DisplayMemberPath="Display" />

                        <TextBlock x:Name="CompatibilityLabel" Text="Compatibility mode (optional):" />
                        <TextBox x:Name="CompatibilityTextBox" Margin="0,2,0,8" />
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="OKButton" Width="80" Margin="0,0,8,0" Click="OKButton_Click" IsDefault="True">OK</Button>
            <Button x:Name="CancelButton" Width="80" Click="CancelButton_Click" IsCancel="True">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>
