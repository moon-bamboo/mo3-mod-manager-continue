<Window x:Class="Mo3ModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mo3ModManager"
        mc:Ignorable="d"
        FontSize="14"
        Title="Mental Omega Mod Manager" Height="450" Width="800" Icon="Icon.ico" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Window.Resources>
        <!-- Shared per-item context menu for mods in ModTreeView. Applied to
             every TreeViewItem via the ItemContainerStyle below. -->
        <ContextMenu x:Key="ModItemContextMenu" Opened="ModItemContextMenu_Opened">
            <MenuItem x:Name="OpenModFolderMenuItem" Click="OpenModFolderMenuItem_Click" Header="_Open Containing Folder..." />
            <Separator />
            <MenuItem x:Name="RenameModMenuItem" Click="RenameModMenuItem_Click" Header="_Rename..." />
            <MenuItem x:Name="ChangeModIdMenuItem" Click="ChangeModIdMenuItem_Click" Header="Change _ID..." />
            <MenuItem x:Name="ToggleHideModMenuItem" Click="ToggleHideModMenuItem_Click" Header="_Hide" />
        </ContextMenu>
    </Window.Resources>
    <Grid>
        <DockPanel LastChildFill="True" >
            <Grid DockPanel.Dock="Bottom" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="icon" Grid.Column="2" >
                    <Button x:Name="RunButton"  Click="RunButton_Click" IsEnabled="False" >
                        <AccessText x:Name="RunButtonText">_Play</AccessText>
                    </Button>
                    <!--<Button x:Name="PropertiesButton" IsEnabled="False">Properties...</Button>-->
                    <!--<Button x:Name="BrowseButton" Click="BrowseButton_Click">Browse...</Button> -->
                    
                    <Button x:Name="InstallModButton" Click="InstallModButton_Click"  >
                        <AccessText x:Name="InstallModButtonText">_Install Mod...</AccessText>
                    </Button>
                    <Button x:Name="DeleteModButton" IsEnabled="False" Click="DeleteModButton_Click">
                        <AccessText x:Name="DeleteModButtonText">_Delete Mod...</AccessText>
                    </Button>
                    <Button x:Name="RefreshButton" Click="RefreshButton_Click" >
                        <AccessText x:Name="RefreshButtonText">_Refresh</AccessText>
                    </Button>
                    
                    <Button x:Name="NewProfileButton" Click="NewProfileButton_Click" >
                        <AccessText x:Name="NewProfileButtonText">_New Profile...</AccessText>
                    </Button>
                    <Button x:Name="RenameProfileButton" IsEnabled="False" Click="RenameProfileButton_Click">
                        <AccessText x:Name="RenameProfileButtonText">_Rename Profile...</AccessText>
                    </Button>
                    <Button x:Name="DeleteProfileButton" Click="DeleteProfileButton_Click" IsEnabled="False" >
                        <AccessText x:Name="DeleteProfileButtonText">D_elete Profile...</AccessText>
                    </Button>
                    <Button x:Name="AboutButton" MouseEnter="AboutButton_MouseEnter" MouseLeave="AboutButton_MouseLeave" Click="AboutButton_Click" >
                        <AccessText x:Name="AboutButtonText">_About...</AccessText>
                    </Button>
                    <Button x:Name="LanguageButton" Click="LanguageButton_Click" >
                        <AccessText x:Name="LanguageButtonText">_Language...</AccessText>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="LanguageContextMenu" Placement="Bottom" />
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <GroupBox x:Name="ProfilesGroupBox" Grid.Column="0" Header="Profiles">
                    <ListView x:Name="ProfilesListView" SelectionChanged="ProfilesListView_SelectionChanged" MouseDoubleClick="ProfilesListView_MouseDoubleClick">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate >
                                <DockPanel >
                                    <Label Content="{Binding Path=SizeInMB}" Foreground="Green"  DockPanel.Dock="Right" HorizontalContentAlignment="Right"/>
                                    <Label  DockPanel.Dock="Left" Content="{Binding Path=Name}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </GroupBox>
            </Grid>


            <GroupBox x:Name="ModsGroupBox"  DockPanel.Dock="Top"  Header="Mods" Margin="5">
              <DockPanel LastChildFill="True">
                <CheckBox x:Name="ShowHiddenModsCheckBox" DockPanel.Dock="Top" Margin="2" Checked="ShowHiddenModsCheckBox_CheckedChanged" Unchecked="ShowHiddenModsCheckBox_CheckedChanged">
                    <AccessText x:Name="ShowHiddenModsCheckBoxText">Show hidden mods</AccessText>
                </CheckBox>
                <TreeView x:Name="ModTreeView" SelectedItemChanged="ModTreeView_SelectedItemChanged">
                    <!--Bind TreeViewItem-->
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type local:ModItem}" ItemsSource="{Binding Items}">
                            <!-- Title already appends a localized "(hidden)" suffix
                                 when IsHidden is true (see ModItem.Title); the trigger
                                 below additionally grays out the text so hidden mods
                                 (only visible at all when "show hidden mods" is
                                 checked) are visually distinct from normal ones. -->
                            <TextBlock x:Name="ModItemTextBlock" Text="{Binding Title}" />
                            <HierarchicalDataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                    <Setter TargetName="ModItemTextBlock" Property="Foreground" Value="Gray" />
                                </DataTrigger>
                            </HierarchicalDataTemplate.Triggers>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>

                    <!--Expanded by default. IsSelected is bound two-way so that
                         setting ModItem.IsSelected in code (e.g. to restore the
                         last-used mod after a rebuild) selects the corresponding
                         TreeViewItem, since TreeView.SelectedItem itself is read-only.
                         PreviewMouseRightButtonDown selects the item under the
                         cursor before the context menu opens, since WPF's TreeView
                         (unlike ListView) does not do this automatically on
                         right-click; without it, right-clicking mod B while mod
                         A is selected would open the menu for mod A.-->
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded" Value="True" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="ContextMenu" Value="{StaticResource ModItemContextMenu}" />
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ModTreeViewItem_PreviewMouseRightButtonDown" />
                        </Style>
                    </TreeView.ItemContainerStyle>


                </TreeView>
              </DockPanel>
            </GroupBox>

        </DockPanel>

    </Grid>
</Window>
