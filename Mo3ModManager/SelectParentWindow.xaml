<Window x:Class="Mo3ModManager.SelectParentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mo3ModManager"
        mc:Ignorable="d"
        FontSize="14"
        Title="Change Parent..." Height="160" Width="320" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="8" FocusManager.FocusedElement="{Binding ElementName=ParentComboBox}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TextBlock" Grid.Row="0" Margin="2" TextWrapping="Wrap" Text="Which mod should be the new parent?" VerticalAlignment="Top" HorizontalAlignment="Stretch"/>

        <ComboBox x:Name="ParentComboBox" Margin="2" Grid.Row="1" DisplayMemberPath="Display" />
        <StackPanel Margin="5" Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" >
            <Button x:Name="OKButton" Click="OKButton_Click" IsDefault="True">OK</Button>
            <Button x:Name="CancelButton" Margin="10,0,0,0" Click="CancelButton_Click" IsCancel="True">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>
